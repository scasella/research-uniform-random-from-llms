# Required for retraining (Path 2). Free credits at https://tinker.thinkingmachines.ai
TINKER_API_KEY=

# Required for the v0.4.1 judge-based scoring pilot. Not needed for Path 1 or v0.4 training.
# Use a cheap chat model like gpt-4.1-mini.
OPENROUTER_API_KEY=

# Optional: HuggingFace model downloads for gated models (e.g. Llama).
HF_TOKEN=

# Optional: experiment tracking
WANDB_API_KEY=
